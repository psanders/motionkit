{
  "name": "@motionkit/core",
  "version": "0.1.0",
  "description": "Shared schemas, types, errors, utils, and the MotionKit rendering engine.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b && npm run copy:brand-assets",
    "build:watch": "tsc -b --watch",
    "copy:brand-assets": "mkdir -p dist/brand/brands && cp -R src/brand/brands/. dist/brand/brands/",
    "lint": "eslint .",
    "test": "mocha"
  },
  "dependencies": {
    "@fonoster/logger": "^0.22.0",
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/renderer": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0",
    "winston": "^3.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
