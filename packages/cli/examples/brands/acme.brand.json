{
  "colors": {
    "primary": "#F97316",
    "secondary": "#111827",
    "background": "#1F2937",
    "text": "#F9FAFB",
    "accent": "#FACC15"
  },
  "typography": {
    "fontFamily": "Georgia, serif",
