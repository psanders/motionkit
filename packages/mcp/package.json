{
  "name": "@motionkit/mcp",
  "version": "0.1.0",
  "description": "MotionKit MCP server — exposes the video engine as MCP tools.",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
