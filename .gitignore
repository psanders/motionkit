node_modules/
dist/
**/src/generated/
*.tsbuildinfo

# Synthesized test fixtures (generated by ffmpeg at test time — see
# packages/core/test/fixtures/generateSampleVideo.ts). Never commit binaries.
**/.fixtures/

# Synthesized example assets (see packages/cli/examples/generate-assets.sh)
# and the video files `motionkit render` produces from them.
packages/cli/examples/assets/
packages/cli/examples/*.mp4

# Isolated agent worktrees (local scratch space, never committed as part of
# whichever change happens to be in flight when one is created)
.claude/worktrees/

# Personal demo footage and rendered output — real video/audio, not synthetic
# fixtures, and never something to commit regardless of the demo's own state
demos/*/assets/
demos/**/*.mp4

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Env
.env
.env.local
.env.*.local

# Coverage
coverage/
